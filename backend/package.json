{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend WebSocket para MVP de conversación en tiempo real",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "dev:agent": "node src/agent.js connect --room=voice-room",
    "dev:token": "node src/token.js"
  },
  "keywords": [
    "websocket",
    "realtime",
    "voice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@deepgram/sdk": "4.11.3",
    "@livekit/agents": "1.0.31",
    "@livekit/agents-plugin-deepgram": "1.0.31",
    "@livekit/agents-plugin-openai": "1.0.31",
    "@livekit/agents-plugin-silero": "1.0.31",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.0.1",
    "livekit-server-sdk": "2.15.0",
    "openai": "6.14.0",
    "ws": "8.18.0"
  }
}
